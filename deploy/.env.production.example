# AYOS production settings. On the server: copy this file to `.env` next to compose.prod.yaml,
# fill in every value, then `chmod 600 .env`. Never commit the filled-in file or paste it into chat.
# Settings that follow from the domain (HTTPS addresses, cookies, CORS) are set in compose.prod.yaml.

# --- Site -------------------------------------------------------------------------------------------
DOMAIN=ayosofficial.com
# Let's Encrypt writes here about certificate problems (use an inbox you read).
ACME_EMAIL=
APP_NAME=AYOS
# Generate once with: echo "base64:$(openssl rand -base64 32)"
# Changing it later logs everyone out and makes encrypted addresses unreadable.
APP_KEY=

# --- Database ---------------------------------------------------------------------------------------
# A long random password: openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=

# --- Redis (cache, sessions, rate limits) -----------------------------------------------------------
# Another long random password, different from DB_PASSWORD: openssl rand -base64 32 | tr -d '/+='
REDIS_PASSWORD=

# --- Live chat (Reverb) -----------------------------------------------------------------------------
# New random values, not the local ones: openssl rand -hex 16 (key), openssl rand -hex 32 (secret).
REVERB_APP_ID=ayos
REVERB_APP_KEY=
REVERB_APP_SECRET=

# --- Email (Brevo SMTP) -----------------------------------------------------------------------------
# Brevo → SMTP & API → SMTP: the login and an SMTP key (not your Brevo password).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be an address on a domain you verified in Brevo.
MAIL_FROM_ADDRESS=hello@ayosofficial.com
MAIL_FROM_NAME=AYOS

# --- Google sign-in ---------------------------------------------------------------------------------
# Google Cloud console → Credentials. Add https://ayosofficial.com/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- reCAPTCHA --------------------------------------------------------------------------------------
# Add ayosofficial.com to the key's allowed domains. The site key is public (built into the app);
# the secret key stays on the server.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Providers and payments -------------------------------------------------------------------------
PROVIDER_FREE_CLIENT_LIMIT=20
PROVIDER_ACTIVATION_FEE=499
# PayMongo live keys. The webhook (https://ayosofficial.com/api/webhooks/paymongo) is created in the
# PayMongo dashboard; its signing secret goes here. QR Ph works now; add gcash,paymaya,card once
# PayMongo has verified the account.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=qrph

# --- Backups (Backblaze B2, see deploy/backup.sh) ---------------------------------------------------
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Backups are encrypted before they leave the server. Keep a copy of this passphrase somewhere safe
# off the server (a password manager): without it, the backups cannot be restored.
BACKUP_PASSPHRASE=
