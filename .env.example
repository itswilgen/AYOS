VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:5180

# Google OAuth web client credentials (server-side only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback

# Local development captures mail in Mailpit. Set these in your ignored .env
# to use an external SMTP provider; never commit provider credentials.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@ayos.test
MAIL_FROM_NAME=AYOS
