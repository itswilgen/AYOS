# Local Docker Compose settings. Do not put secret credentials in this file.
VITE_BACKEND_URL=http://localhost:8010
VITE_API_BASE_URL=http://localhost:8010/api
FRONTEND_URL=http://localhost:5180

# Local development captures mail in Mailpit. Set these in your ignored .env
# to use an external SMTP provider; never commit provider credentials.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@ayos.test
MAIL_FROM_NAME=AYOS
# Public reCAPTCHA v2 site key for frontend localhost development.
VITE_RECAPTCHA_SITE_KEY=
