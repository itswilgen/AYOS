# Production web image: builds the React app once, then serves it with Caddy, which also handles HTTPS
# and sends API, sign-in and live-chat traffic to the right container (see deploy/Caddyfile).
FROM node:22.23.5-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Vite bakes these into the JavaScript at build time; they are public values, never secrets.
ARG VITE_BACKEND_URL
ARG VITE_API_BASE_URL
ARG VITE_RECAPTCHA_SITE_KEY
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https
RUN test -n "$VITE_BACKEND_URL" && test -n "$VITE_RECAPTCHA_SITE_KEY" && test -n "$VITE_REVERB_APP_KEY" \
    || { echo "Set VITE_BACKEND_URL, VITE_RECAPTCHA_SITE_KEY and VITE_REVERB_APP_KEY in .env before building." >&2; exit 1; }
RUN npm run build

FROM caddy:2.11.7-alpine
COPY --from=build /app/dist /srv/app
COPY deploy/Caddyfile /etc/caddy/Caddyfile
