APP_NAME=AYOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5180

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ayos
DB_USERNAME=ayos
DB_PASSWORD=ayos-local-dev-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:5180,127.0.0.1:5180,localhost:8010,127.0.0.1:8010
CORS_ALLOWED_ORIGINS=http://localhost:5180

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@ayos.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth web client credentials (server-side only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback
# Keep credentials local; these values are never committed.
RECAPTCHA_SECRET_KEY=

# Provider quota. Leave the fee blank until billing is connected.
PROVIDER_FREE_CLIENT_LIMIT=10
PROVIDER_ACTIVATION_FEE=
