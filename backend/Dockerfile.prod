# Production image: PHP-FPM with the code and production dependencies baked in.
# The same image runs the API (php-fpm), the release step (migrations) and live chat (reverb).
FROM composer:2 AS composer-bin

FROM php:8.4.27-fpm-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libfcgi-bin libicu-dev libjpeg62-turbo-dev libonig-dev libpng-dev libpq-dev libwebp-dev libxml2-dev libzip-dev unzip \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" bcmath exif gd intl mbstring opcache pcntl pdo_pgsql zip \
    && rm -rf /var/lib/apt/lists/*

# Redis client for the cache, sessions and rate-limit counters (pinned version).
# libfcgi-bin (above) gives `cgi-fcgi`, which the container health check uses to ping PHP-FPM.
RUN pecl install redis-6.1.0 && docker-php-ext-enable redis

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php-prod.ini /usr/local/etc/php/conf.d/zz-ayos.ini
COPY docker/fpm-pool.conf /usr/local/etc/php-fpm.d/zz-ayos.conf
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress --no-scripts --no-autoloader

COPY . .
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative --no-interaction \
    && rm -f .env \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/prod-entrypoint.sh /usr/local/bin/ayos-prod
RUN chmod +x /usr/local/bin/ayos-prod

ENTRYPOINT ["ayos-prod"]
CMD ["php-fpm"]
